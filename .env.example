# ==========================================
# AI Shopping Agent — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git
# ==========================================

# --- Database (Neon Serverless PostgreSQL) ---
# Lấy từ Neon Console → Connection Details → Connection string
# Dùng Pooler endpoint để tránh vượt connection limit
# Format: ep-xxx-pooler.region.aws.neon.tech
DB_HOST=ep-your-project-pooler.region.aws.neon.tech
DB_NAME=shopping_agent
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Cloudinary (upload ảnh sản phẩm) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Spring Boot ---
# Local: dev | Production (VPS): docker-compose.prod.yml tự đặt prod
SPRING_PROFILES_ACTIVE=dev

# --- Security & JWT ---
# BẮT BUỘC: Chuỗi bí mật ký JWT với entropy tối thiểu 256 bits (>= 32 bytes ngẫu nhiên)
# Tạo nhanh bằng lệnh: openssl rand -base64 48
# TUYỆT ĐỐI KHÔNG dùng chuỗi mặc định dễ đoán. Ứng dụng sẽ từ chối khởi động nếu thiếu hoặc không an toàn.
JWT_SECRET=your_super_secret_high_entropy_jwt_key_here_at_least_32_bytes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Ports ---
# Local (docker-compose.yml): 8080 / 3000
# Production (docker-compose.prod.yml): chỉ dùng FRONTEND_PORT, mặc định 80
BACKEND_PORT=8080
FRONTEND_PORT=3000

# CORS: origin Frontend được phép (phân tách bằng dấu phẩy). Production nên đặt cụ thể, vd: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=*
