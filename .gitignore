# ==========================================
# AI Shopping Agent — .gitignore
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.development

# Credentials, Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
credentials.json
client_secret*.json
service-account*.json
secrets/
**/secrets/

# --- GitGuardian Local Cache ---
.gitguardian/

# --- Java / Maven (Backend) ---
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.jar
*.flat

# --- Node / React / Vite (Frontend) ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python (Scripts & Data Crawlers) ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
*.sqlite3

# --- IDE & Editors ---
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/
**/.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
*.suo
*.user
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs & Temp ---
*.log
logs/*
!logs/.gitkeep
**/logs/*
!**/logs/.gitkeep
tmp/
temp/